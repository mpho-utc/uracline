---
// import '@google/model-viewer';

const navItems = [
   {
    label: "Home",
    href: "/",
  },
  {
    label: "Insights",
    href: "/insights/",
  },
  {
    label: "About",
    href: "/about/",
  },
];

const currentPath = Astro.url.pathname;

const isActive = (href: string) => {
  if (href === "/") {
    return currentPath === "/";
  }

  return currentPath === href || currentPath.startsWith(href);
};
---

<header class="site-header">
  <div class="header-inner">
<!-- <a
  href="/"
  class="header-logo"
  aria-label="Uracline Space home"
>
  <model-viewer
    src="/resources/logo.glb"
    alt="Uracline Space logo"
    class="header-logo-mark"
    auto-rotate
    disable-zoom
    interaction-prompt="none"
    shadow-intensity="0"
  ></model-viewer> 
</a>-->
    <a
      href="/"
      class="header-logo"
      aria-label="Uracline Space home"
    >
      <img
        src="/resources/uracline_logo.png"
        alt="Uracline Space logo"
        class="header-logo-mark"
      />
    </a>

    <nav
      class="desktop-navigation"
      aria-label="Main navigation"
    >
      <div class="nav-links">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class:list={{
                "nav-link": true,
                active: isActive(item.href),
              }}
            >
              {item.label}
            </a>
          ))
        }
      </div>

      <a href="mailto:tumelorabane458@gmail.com" class="nav-cta">
        <span>Talk to us</span>
        <span aria-hidden="true">→</span>
      </a>
    </nav>

    <button
      class="nav-toggle"
      type="button"
      aria-label="Open navigation"
      aria-expanded="false"
      aria-controls="mobile-navigation"
    >
      <span></span>
      <span></span>
    </button>

  </div>

  <nav
    id="mobile-navigation"
    class="mobile-navigation"
    aria-label="Mobile navigation"
  >
    <div class="mobile-navigation-inner">

      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={{
              "mobile-nav-link": true,
              active: isActive(item.href),
            }}
          >
            <span>{item.label}</span>
            <span aria-hidden="true">→</span>
          </a>
        ))
      }

      <a href="mailto:tumelorabane458@gmail.com" class="mobile-nav-cta">
        <span>Talk to us</span>
        <span aria-hidden="true">→</span>
      </a>

    </div>
  </nav>
</header>


<script>
  const toggle =
    document.querySelector<HTMLButtonElement>(".nav-toggle");

  const mobileNavigation =
    document.querySelector<HTMLElement>(".mobile-navigation");

  if (toggle && mobileNavigation) {
    toggle.addEventListener("click", () => {
      const isOpen =
        mobileNavigation.classList.toggle("open");

      toggle.classList.toggle("open", isOpen);

      toggle.setAttribute(
        "aria-expanded",
        String(isOpen)
      );

      toggle.setAttribute(
        "aria-label",
        isOpen
          ? "Close navigation"
          : "Open navigation"
      );

      document.body.classList.toggle(
        "menu-open",
        isOpen
      );
    });

    mobileNavigation
      .querySelectorAll("a")
      .forEach((link) => {
        link.addEventListener("click", () => {
          mobileNavigation.classList.remove("open");
          toggle.classList.remove("open");

          toggle.setAttribute(
            "aria-expanded",
            "false"
          );

          toggle.setAttribute(
            "aria-label",
            "Open navigation"
          );

          document.body.classList.remove(
            "menu-open"
          );
        });
      });
  }
</script>


<style>
  /* =================================
     URACLINE SPACE — HEADER
  ================================= */

  .site-header {
    position: fixed;
    z-index: 1000;

    top: 0;
    left: 0;

    width: 100%;
    max-width: 100vw;

    box-sizing: border-box;

    border-bottom: 1px solid
      rgba(228, 231, 235, 0.8);

    background: rgba(255, 255, 255, 0.88);

    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);

    overflow-x: clip;
  }

  .header-inner {
    width: min(1180px, calc(100% - 48px));
    max-width: 100%;

    height: 76px;

    margin: 0 auto;

    box-sizing: border-box;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 24px;
  }

  /* =================================
     LOGO
  ================================= */

  .header-logo {
    display: inline-flex;
    align-items: center;

    flex: 0 0 auto;

    min-width: 0;

    text-decoration: none;

    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .header-logo:hover {
    opacity: 0.85;
    transform: translateY(-1px);
  }

  .header-logo-mark {
    display: block;

    width: auto;
    max-width: 100%;

    height: 50px;

    object-fit: contain;
  }

  /* =================================
     DESKTOP NAVIGATION
  ================================= */

  .desktop-navigation {
    display: flex;
    align-items: center;
    justify-content: flex-end;

    flex: 0 1 auto;

    min-width: 0;

    gap: 32px;
  }

  .nav-links {
    display: flex;
    align-items: center;

    flex: 0 1 auto;

    gap: 30px;
  }

  .nav-link {
    position: relative;

    display: inline-flex;
    align-items: center;

    flex: 0 0 auto;

    padding: 8px 0;

    color: #343a43;

    font-family: Inter, sans-serif;
    font-size: 14px;
    font-weight: 500;

    line-height: 1;

    white-space: nowrap;

    text-decoration: none;

    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }

  .nav-link::after {
    content: "";

    position: absolute;

    left: 0;
    bottom: 1px;

    width: 0;
    height: 1px;

    background: #1557d5;

    transition: width 0.2s ease;
  }

  .nav-link:hover {
    color: #0d0d0d;
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    width: 100%;
  }

  .nav-link.active {
    color: #1557d5;
  }

  /* =================================
     CTA
  ================================= */

  .nav-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    flex: 0 0 auto;

    gap: 8px;

    min-height: 42px;

    padding: 0 17px;

    box-sizing: border-box;

    border: 1px solid #1557d5;
    border-radius: 6px;

    color: #ffffff;
    background: #1557d5;

    font-family: Inter, sans-serif;
    font-size: 13px;
    font-weight: 600;

    line-height: 1;

    white-space: nowrap;

    text-decoration: none;

    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .nav-cta:hover {
    border-color: #2d7cff;
    background: #2d7cff;

    transform: translateY(-1px);
  }

  /* =================================
     MOBILE TOGGLE
  ================================= */

  .nav-toggle {
    display: none;

    position: relative;

    flex: 0 0 42px;

    width: 42px;
    height: 42px;

    padding: 0;

    box-sizing: border-box;

    border: 1px solid #e4e7eb;
    border-radius: 6px;

    background: #ffffff;

    cursor: pointer;
  }

  .nav-toggle span {
    position: absolute;

    left: 11px;

    width: 18px;
    height: 1.5px;

    background: #15171b;

    transition:
      transform 0.25s ease,
      top 0.25s ease;
  }

  .nav-toggle span:first-child {
    top: 16px;
  }

  .nav-toggle span:last-child {
    top: 23px;
  }

  .nav-toggle.open span:first-child {
    top: 20px;
    transform: rotate(45deg);
  }

  .nav-toggle.open span:last-child {
    top: 20px;
    transform: rotate(-45deg);
  }

  /* =================================
     MOBILE NAVIGATION
  ================================= */

  .mobile-navigation {
    display: none;
  }

  /* =================================
     FOCUS
  ================================= */

  .header-logo:focus-visible,
  .nav-link:focus-visible,
  .nav-cta:focus-visible,
  .nav-toggle:focus-visible,
  .mobile-nav-link:focus-visible,
  .mobile-nav-cta:focus-visible {
    outline: 2px solid #2d7cff;
    outline-offset: 4px;
  }

  /* =================================
     TABLET
  ================================= */

  @media (max-width: 800px) {
    .desktop-navigation {
      gap: 20px;
    }

    .nav-links {
      gap: 20px;
    }
  }

  /* =================================
     MOBILE
  ================================= */

  @media (max-width: 700px) {
    .site-header {
      background: rgba(255, 255, 255, 0.94);
    }

    .header-inner {
      width: 100%;
      max-width: 100%;

      height: 68px;

      padding-left: 20px;
      padding-right: 20px;

      gap: 16px;
    }

    .header-logo {
      min-width: 0;

      overflow: hidden;
    }

    .header-logo-mark {
      height: 44px;
      width: auto;
      max-width: 180px;
    }

    .desktop-navigation {
      display: none;
    }

    .nav-toggle {
      display: block;

      z-index: 1002;
    }

    /* -------------------------------
       MOBILE MENU
    -------------------------------- */

    .mobile-navigation {
      position: fixed;
      z-index: 1001;

      top: 68px;
      left: 0;

      width: 100%;
      max-width: 100vw;

      box-sizing: border-box;

      display: block;

      max-height: 0;

      overflow: hidden;

      border-bottom: 1px solid transparent;

      background: rgba(255, 255, 255, 0.98);

      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);

      opacity: 0;
      visibility: hidden;

      transition:
        max-height 0.35s ease,
        opacity 0.25s ease,
        visibility 0.25s ease,
        border-color 0.25s ease;
    }

    .mobile-navigation.open {
      max-height: calc(100vh - 68px);

      overflow-y: auto;
      overflow-x: hidden;

      border-bottom-color: #e4e7eb;

      opacity: 1;
      visibility: visible;
    }

    .mobile-navigation-inner {
      width: 100%;
      max-width: 100%;

      box-sizing: border-box;

      margin: 0;

      padding: 12px 20px 24px;
    }

    .mobile-nav-link {
      display: flex;
      align-items: center;
      justify-content: space-between;

      width: 100%;
      max-width: 100%;

      min-height: 58px;

      box-sizing: border-box;

      border-bottom: 1px solid #f0f1f3;

      color: #343a43;

      font-family: Inter, sans-serif;
      font-size: 15px;
      font-weight: 500;

      text-decoration: none;

      transition:
        color 0.2s ease,
        padding-left 0.2s ease;
    }

    .mobile-nav-link:hover {
      padding-left: 4px;
      color: #1557d5;
    }

    .mobile-nav-link.active {
      color: #1557d5;
    }

    .mobile-nav-link span {
      min-width: 0;
    }

    .mobile-nav-link span:last-child {
      flex: 0 0 auto;

      font-size: 17px;
    }

    .mobile-nav-cta {
      display: flex;
      align-items: center;
      justify-content: space-between;

      width: 100%;
      max-width: 100%;

      min-height: 50px;

      margin-top: 18px;
      padding: 0 17px;

      box-sizing: border-box;

      border: 1px solid #1557d5;
      border-radius: 6px;

      color: #ffffff;
      background: #1557d5;

      font-family: Inter, sans-serif;
      font-size: 14px;
      font-weight: 600;

      text-decoration: none;
    }

    body.menu-open {
      overflow: hidden;
    }
  }

  /* =================================
     VERY SMALL SCREENS
  ================================= */

  @media (max-width: 360px) {
    .header-inner {
      padding-left: 16px;
      padding-right: 16px;
    }

    .header-logo-mark {
      max-width: 150px;
    }

    .mobile-navigation-inner {
      padding-left: 16px;
      padding-right: 16px;
    }
  }

  /* =================================
     REDUCED MOTION
  ================================= */

  @media (prefers-reduced-motion: reduce) {
    .header-logo,
    .nav-link,
    .nav-link::after,
    .nav-cta,
    .nav-toggle span,
    .mobile-navigation,
    .mobile-nav-link {
      transition: none;
    }

    .header-logo:hover,
    .nav-cta:hover {
      transform: none;
    }
  }
</style>