        <h4>Explore</h4>

        <a href="/insights/">Insights</a>
        <a href="/about/#team">Team</a>
        <a href="/about/">About</a>
        <a href="/#ambition">Our direction</a>
      </div>

      <!-- COMPANY -->
      <div class="footer-column">
        <h4>Company</h4>

        <a href="/about/#beliefs">Our philosophy</a>
        <a href="/about/#trust">Trust</a>
        <a href="mailto:tumelorabane458@gmail.com">Contact</a>
      </div>

      <!-- CONNECT -->
      <div class="footer-column">
        <h4>Connect</h4>

        <a
          href="https://www.linkedin.com/company/uracline-space/"
          target="_blank"
          rel="noopener noreferrer"
        >
          LinkedIn
        </a>

        <a
          href="https://www.facebook.com/profile.php?id=61592486981478"
          target="_blank"
          rel="noopener noreferrer"
        >
          Facebook
        </a>

        <a
          href="https://www.instagram.com/uracline_space?igsi=MWFwdWE2YWVvM2p2"
          target="_blank"
          rel="noopener noreferrer"
        >
          Instagram
        </a>

        <a href="mailto:tumelorabane458@gmail.com">
          Email
        </a>
      </div>

    </div>

    <!-- FOOTER BOTTOM -->
