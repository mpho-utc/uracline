---
import Layout, { type SEOProps } from "../../layouts/Layout.astro";

const seo: SEOProps = {
  title: "About — Uracline Space",
  description:
    "Learn about Uracline Space, the people behind the company, what we do, where we are based, and the work we are developing across finance, business and technology.",
  robots: "index, follow, max-image-preview:large",
  author: "Uracline Space",
  canonical: "https://uraclinespace.com/about/",
  keywords:
    "Uracline Space, about Uracline Space, financial technology, taxation, accounting, compliance, financial management",
  og: {
    title: "About — Uracline Space",
    description:
      "Learn about Uracline Space, the people behind the company, what we do, where we are based, and the work we are developing across finance, business and technology.",
    type: "website",
    url: "https://uraclinespace.com/about/",
    image: "https://uraclinespace.com/resources/uracline_logo.png",
    imageAlt: "Uracline Space",
  },
  twitter: {
    card: "summary_large_image",
    title: "About — Uracline Space",
    description:
      "Learn about Uracline Space, the people behind the company, what we do, where we are based, and the work we are developing across finance, business and technology.",
    image: "https://uraclinespace.com/resources/uracline_logo.png",
  },
  schema: {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    name: "About — Uracline Space",
    url: "https://uraclinespace.com/about/",
    description:
      "Learn about Uracline Space, the people behind the company, what we do, where we are based, and the work we are developing across finance, business and technology.",
    isPartOf: {
      "@type": "WebSite",
      name: "Uracline Space",
      url: "https://uraclinespace.com/",
    },
  },
};
---

<Layout seo={seo}>
  <div id="top">
    <!-- ================================                                                                                                                                                                                                                                                                                                              
           HERO                                                                                                                                                                                                                                                                                                                                           
      ================================= -->
    <section class="hero">
      <div class="hero-watermark" aria-hidden="true">
        <div class="watermark-blue"></div>
        <div class="watermark-orange"></div>
      </div>
      <div class="container">
        <div class="hero-content reveal">
          <h1>
            Who we are.
            <span>What we are building.</span>
          </h1>
          <p class="hero-description">
            Uracline Space is a South African financial technology company
            working across finance, business and technology. We are developing
            practical solutions for financial and business processes that can be
            difficult to navigate.
          </p>
          <div class="company-meta">
            <div class="meta-item">
              <span class="meta-label"> Based in </span>
              <span class="meta-value">
                Midrand(Johannesburg), South Africa
              </span>
            </div>
            <div class="meta-item">
              <span class="meta-label"> Established </span>
              <span class="meta-value"> 2026 </span>
            </div>
            <div class="meta-item">
              <span class="meta-label"> Company </span>
              <span class="meta-value"> Uracline Space (Pty) Ltd </span>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- ================================                                                                                                                                                                                                                                                                                                              
           COMPANY                                                                                                                                                                                                                                                                                                                                        
      ================================= -->
    <section class="section company">
      <div class="container company-grid">
        <div class="reveal">
          <h2>A company built around finance, business and technology.</h2>
        </div>
        <div class="company-copy reveal">
          <p>
            Uracline Space operates at the intersection of financial knowledge
            and technology.
          </p>
          <p>
            Our work covers financial technology, business processes,
            accounting, taxation, compliance, financial management, research and
            related areas.
          </p>
          <p>
            We are developing the company around the idea that financial and
            business information should be easier to work with, understand and
            apply.
          </p>
          <div class="company-details">
            <div class="detail">
              <div class="detail-label">Sector</div>
              <div class="detail-value">Financial Technology</div>
            </div>
            <div class="detail">
              <div class="detail-label">Structure</div>
              <div class="detail-value">Private Company</div>
            </div>
            <div class="detail">
              <div class="detail-label">Focus</div>
              <div class="detail-value">Finance &amp; Technology</div>
            </div>
            <div class="detail">
              <div class="detail-label">Approach</div>
              <div class="detail-value">Practical &amp; Analytical</div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- ================================                                                                                                                                                                                                                                                                                                              
           WHAT WE DO                                                                                                                                                                                                                                                                                                                                     
      ================================= -->
    <section class="section what-we-do">
      <div class="container">
        <div class="what-header reveal">
          <h2>Our work spans several connected areas.</h2>
          <p>
            Uracline Space is developing products, services, information and
            technology around financial and business needs.
          </p>
        </div>
        <div class="areas-grid">
          <article class="area reveal">
            <div class="area-icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><rect x="4" y="3" width="16" height="18" rx="2"></rect><path
                  d="M8 7h8"></path><path d="M8 11h2"></path><path d="M14 11h2"
                ></path><path d="M8 15h2"></path><path d="M14 15h2"></path><path
                  d="M8 18h8"></path></svg>
            </div>
            <h3>Financial Technology</h3>
            <p>
              Developing technology that can improve the way financial
              information and processes are managed.
            </p>
          </article>
          <article class="area reveal">
            <div class="area-icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M6 3h12v18H6z"></path><path d="M9 7h6"></path><path
                  d="M9 11h6"></path><path d="M9 15h3"></path><path d="M9 18h6"
                ></path></svg>
            </div>
            <h3>Accounting &amp; Finance</h3>
            <p>
              Working with financial information, accounting processes and the
              practical financial needs of businesses.
            </p>
          </article>
          <article class="area reveal">
            <div class="area-icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M12 3 20 6v6c0 5-3.4 8-8 9-4.6-1-8-4-8-9V6l8-3Z"
                ></path><path d="m8.5 12 2.2 2.2 4.8-5"></path></svg>
            </div>
            <h3>Tax &amp; Compliance</h3>
            <p>
              Developing and supporting solutions connected to taxation,
              compliance and related business obligations.
            </p>
          </article>
          <article class="area reveal">
            <div class="area-icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><rect x="3" y="7" width="18" height="13" rx="2"></rect><path
                  d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><path
                  d="M3 12h18"></path><path d="M10 12v2h4v-2"></path></svg>
            </div>
            <h3>Business Solutions</h3>
            <p>
              Looking at business processes and identifying opportunities to
              improve how organisations operate.
            </p>
          </article>
          <article class="area reveal">
            <div class="area-icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><circle cx="10.8" cy="10.8" r="6.8"></circle><path
                  d="m16 16 5 5"></path><path d="M8 10.8h5.6"></path><path
                  d="M10.8 8v5.6"></path></svg>
            </div>
            <h3>Research &amp; Knowledge</h3>
            <p>
              Researching financial and business topics and turning useful
              information into accessible knowledge.
            </p>
          </article>
          <article class="area reveal">
            <div class="area-icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><rect x="3" y="3" width="7" height="7" rx="1"></rect><rect
                  x="14"
                  y="3"
                  width="7"
                  height="7"
                  rx="1"></rect><rect x="14" y="14" width="7" height="7" rx="1"
                ></rect><rect x="3" y="14" width="7" height="7" rx="1"
                ></rect><path d="M10 6.5h4"></path><path d="M17.5 10v4"
                ></path><path d="M14 17.5h-4"></path><path d="M6.5 14v-4"
                ></path></svg>
            </div>
            <h3>Systems &amp; Technology</h3>
            <p>
              Exploring how information, systems and technology can work
              together more effectively.
            </p>
          </article>
        </div>
      </div>
    </section>
    <!-- ================================                                                                                                                                                                                                                                                                                                              
           TEAM                                                                                                                                                                                                                                                                                                                                           
      ================================= -->
    <section class="section team" id="team">
      <div class="container">
        <div class="team-header">
          <div class="reveal">
            <h2>Two founders. Different strengths.</h2>
          </div>
          <p class="reveal">
            Uracline Space is founder-led, with each founder contributing a
            different area of expertise to the development of the company.
          </p>
        </div>
        <div class="team-grid">
          <!-- ==========================                                                                                                                                                                                                                                                                                                              
                 MPHO                                                                                                                                                                                                                                                                                                                                     
            =========================== -->
          <article class="team-card reveal">
            <div class="team-photo" aria-label="Mpho">
              <div class="team-orbit team-orbit-one" aria-hidden="true"></div>
              <div class="team-orbit team-orbit-two" aria-hidden="true"></div>
              <img
                src="/resources/Mpho.jpeg"
                alt="Mpho — Uracline Space"
                loading="lazy"
              />
            </div>
            <h3>Mpho Shabalala</h3>
            <div class="team-role">Co-Founder &amp; CEO</div>
            <p>
              Mpho is a multidisciplinary business and technology professional
              with expertise spanning business, information, technology, and
              systems.
            </p>
            <p>
              He brings a practical and analytical approach to understanding
              business challenges, developing solutions, and improving how
              organisations operate.
            </p>
            <p>
              His role at Uracline Space extends across business development,
              technology, systems, product development and the exploration of
              new opportunities.
            </p>
            <div class="team-focus">
              <span>Business</span>
              <span>Technology</span>
              <span>Systems</span>
              <span>Innovation</span>
              <span>Product</span>
            </div>
          </article>
          <!-- ==========================                                                                                                                                                                                                                                                                                                              
                 TUMELO                                                                                                                                                                                                                                                                                                                                   
            =========================== -->
          <article class="team-card reveal">
            <div class="team-photo" aria-label="Tumelo">
              <div class="team-orbit team-orbit-one" aria-hidden="true"></div>
              <div class="team-orbit team-orbit-two" aria-hidden="true"></div>
              <img
                src="/resources/Tumelo.jpeg"
                alt="Tumelo — Uracline Space"
                loading="lazy"
              />
            </div>
            <h3>Tumelo Molekwa</h3>
            <div class="team-role">Co-Founder &amp; CFO</div>
            <p>
              Tumelo is an accounting and finance professional with a <strong
                >Bachelor of Accounting (BACC) from the University of
                Johannesburg</strong
              >.
            </p>
            <p>
              He brings a strong foundation in accounting, finance, business and
              financial analysis, together with a strong interest in research
              and problem-solving.
            </p>
            <p>
              As CFO, Tumelo is responsible for the company's financial
              direction and contributes to research, analysis, business
              development and product thinking.
            </p>
            <p>
              His approach is grounded in&nbsp;
              <strong
                >integrity, ethics, accountability and sound judgement</strong
              >.
            </p>
            <div class="team-focus">
              <span>Accounting</span>
              <span>Finance</span>
              <span>Research</span>
              <span>Analysis</span>
              <span>Strategy</span>
            </div>
          </article>
        </div>
      </div>
    </section>
    <!-- ================================
           MISSION & VISION
      ================================= -->
    <section class="section mission-vision" id="mission-vision">
      <div class="container">
        <div class="mission-vision-header reveal">
          <h2>Technology should make financial life easier to navigate.</h2>
          <p>
            Our mission and vision are grounded in a simple belief: technology
            should simplify workflows around money and help people understand
            important financial matters accurately, especially when the
            consequences of getting them wrong are significant.
          </p>
        </div>

        <div class="mission-vision-grid">
          <article class="mission-card reveal">
            <div class="mission-icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M12 3v18"></path>
                <path d="M5 8h14"></path>
                <path d="M7 8l-3 6a4 4 0 0 0 6 0L7 8Z"></path>
                <path d="M17 8l-3 6a4 4 0 0 0 6 0l-3-6Z"></path>
                <path d="M7 3h10"></path>
              </svg>
            </div>
            <h3>Our mission</h3>
            <p>
              To build technology that simplifies financial workflows, organises
              complexity and provides people with accurate, understandable
              information they can use to make better decisions.
            </p>
          </article>

          <article class="vision-card reveal">
            <div class="vision-icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="8.5"></circle>
                <path d="M12 7v5l3.5 2"></path>
                <path d="M4.5 4.5 3 3"></path>
                <path d="m19.5 4.5 1.5-1.5"></path>
              </svg>
            </div>
            <h3>Our vision</h3>
            <p>
              To build a connected financial technology ecosystem where
              technology makes financial and business processes easier to
              understand, manage and act on, and where people can approach
              critical financial matters with greater clarity and confidence.
            </p>
          </article>
        </div>

        <div class="mission-principle reveal">
          <div class="principle-line"></div>
          <p>
            Simplify the workflow. Inform accurately. Help people act with
            clarity.
          </p>
        </div>
      </div>
    </section>

    <section class="section partnership">
      <div class="container partnership-grid">
        <div class="partnership-copy reveal">
          <h2>Complementary expertise.</h2>
          <p>
            Mpho and Tumelo bring different professional backgrounds to the
            company.
          </p>
          <p>
            Mpho's work is centred around business, technology, systems and
            product development, while Tumelo brings accounting, finance,
            research and analytical expertise.
          </p>
          <p>
            Their combined perspective informs how Uracline Space evaluates
            problems, develops ideas and approaches potential solutions.
          </p>
          <div class="partnership-statement">
            Different disciplines.<br />
            Shared direction.
          </div>
        </div>
        <div class="partnership-visual reveal">
          <div class="connection">
            <div class="connection-line"></div>
            <div class="connection-node">
              Business<br />
              &amp; Technology
            </div>
            <div class="connection-center">Uracline</div>
            <div class="connection-node">
              Accounting<br />
              &amp; Finance
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- ================================                                                                                                                                                                                                                                                                                                              
           BELIEFS                                                                                                                                                                                                                                                                                                                                        
      ================================= -->
    <section class="section belief" id="beliefs">
      <div class="container belief-grid">
        <div class="reveal">
          <h2>Practical thinking comes first.</h2>
          <p class="belief-copy" style="margin-top: 28px;">
            Our approach is shaped by the problems we are working with and by
            what we learn while developing the company.
          </p>
        </div>
        <div class="belief-list reveal">
          <div class="belief-item">
            <div class="belief-icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"
                ></path><path d="M11 8v6"></path><path d="M8 11h6"></path></svg>
            </div>
            <h3>Understand the problem.</h3>
            <p>
              We try to understand the underlying problem before deciding what
              solution is appropriate.
            </p>
          </div>
          <div class="belief-item">
            <div class="belief-icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M6 3h12v18H6z"></path><path d="M9 7h6"></path><path
                  d="M9 11h6"></path><path d="m9 15 2 2 4-4"></path></svg>
            </div>
            <h3>Work with evidence.</h3>
            <p>
              Research and reliable information form an important part of how we
              investigate subjects and opportunities.
            </p>
          </div>
          <div class="belief-item">
            <div class="belief-icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M14 6 6 14"></path><path d="m8 16-3 3"></path><path
                  d="m15 3 6 6"></path><path d="m13 8 3 3"></path><path
                  d="M4 20l2-2"></path></svg>
            </div>
            <h3>Build for practical use.</h3>
            <p>
              We focus on solutions that can be useful in real-world business
              and financial environments.
            </p>
          </div>
          <div class="belief-item">
            <div class="belief-icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M4 5h16v12H4z"></path><path d="M8 21h8"></path><path
                  d="M12 17v4"></path><path d="m8 9 2.5 2.5L16 7"></path></svg>
            </div>
            <h3>Keep learning.</h3>
            <p>
              Uracline Space is still developing, and our work continues to
              evolve as we learn and build.
            </p>
          </div>
        </div>
      </div>
    </section>
    <!-- ================================                                                                                                                                                                                                                                                                                                              
           DIRECTION                                                                                                                                                                                                                                                                                                                                      
      ================================= -->
    <section class="section direction" id="direction">
      <div class="container">
        <h2 class="reveal">Uracline Space is still being built.</h2>
        <p class="direction-copy reveal">
          We are developing the company across financial technology, business
          solutions, knowledge and related services. The long-term direction is
          to build connected solutions that make financial and business
          processes easier to manage and understand.
        </p>
        <div class="direction-statement reveal">
          From understanding problems<br />
          to building useful solutions.
        </div>
      </div>
    </section>
    <!-- ================================                                                                                                                                                                                                                                                                                                              
           CTA                                                                                                                                                                                                                                                                                                                                            
      ================================= -->
    <section class="final-cta">
      <div class="container final-cta-inner">
        <div>
          <h2>Explore what we are building.</h2>
          <p>
            Learn more about our solutions, explore our knowledge and insights,
            or get in touch with us.
          </p>
        </div>
        <div class="cta-actions">
          <a href="/about/" class="btn btn-primary">
            Explore our solutions →
          </a>
          <a href="/insights/" class="btn btn-outline"> Explore knowledge → </a>
          <a href="mailto:tumelorabane458@gmail.com" class="btn btn-outline">
            Talk to us →
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap");

  :root {
    --orange: #ff6a2c;
    --orange-light: #ff8f52;
    --orange-soft: #fff1e8;
    --blue: #1557d5;
    --blue-bright: #2d7cff;
    --blue-soft: #eaf1ff;
    --black: #0d0d0d;
    --ink: #15171b;
    --white: #ffffff;
    --grey-50: #fafafa;
    --grey-100: #f4f5f7;
    --grey-200: #e4e7eb;
    --grey-300: #d1d5db;
    --grey-500: #68707c;
    --grey-700: #343a43;
    --max: 1180px;
    --display: "Space Grotesk", sans-serif;
    --body: "Inter", sans-serif;
    --mono: "IBM Plex Mono", monospace;
  }
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  :global(html) {
    scroll-behavior: smooth;
  }
  :global(body) {
    font-family: var(--body);
    color: var(--ink);
    background: var(--white);
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }
  :global(body.menu-open) {
    overflow: hidden;
  }
  :global(a) {
    color: inherit;
    text-decoration: none;
  }
  :global(img) {
    display: block;
    width: 100%;
  }
  :global(button) {
    font: inherit;
  }
  :global(::selection) {
    background: var(--blue);
    color: white;
  }
  .container {
    width: min(var(--max), calc(100% - 64px));
    margin: 0 auto;
  }
  .mono {
    font-family: var(--mono);
  }
  h1,
  h2,
  h3 {
    font-family: var(--display);
    letter-spacing: -0.035em;
    line-height: 1.05;
  }
  h1 {
    font-size: clamp(3.4rem, 7vw, 6.3rem);
    font-weight: 600;
  }
  h2 {
    font-size: clamp(2.5rem, 5vw, 4.4rem);
    font-weight: 600;
  }
  h3 {
    font-size: 1.35rem;
  }
  .section {
    padding: 120px 0;
  }
  /* ================================                                                                                                                                                                                                                                                                                                                
         BUTTONS                                                                                                                                                                                                                                                                                                                                          
      ================================= */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-height: 48px;
    padding: 0 20px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 600;
    transition:
      transform 0.2s ease,
      background 0.2s ease,
      border-color 0.2s ease;
  }
  .btn:hover {
    transform: translateY(-2px);
  }
  .btn-primary {
    color: white;
    background: var(--orange);
  }
  .btn-primary:hover {
    background: var(--orange-light);
  }
  .btn-outline {
    color: var(--black);
    border: 1px solid var(--grey-300);
    background: white;
  }
  .btn-outline:hover {
    border-color: var(--black);
  }
  /* ================================                                                                                                                                                                                                                                                                                                                
         HERO                                                                                                                                                                                                                                                                                                                                             
      ================================= */
  .hero {
    position: relative;
    overflow: hidden;
    padding: 175px 0 115px;
    background:
      linear-gradient(rgba(13, 13, 13, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(13, 13, 13, 0.045) 1px, transparent 1px);
    background-size: 48px 48px;
  }
  .hero::after {
    content: "";
    position: absolute;
    width: 700px;
    height: 700px;
    top: 40px;
    right: -300px;
    background: radial-gradient(
      circle,
      rgba(21, 87, 213, 0.13),
      transparent 68%
    );
    pointer-events: none;
  }
  .hero-watermark {
    position: absolute;
    width: 600px;
    height: 600px;
    top: 50%;
    left: 65%;
    transform: translate(-50%, -50%);
    pointer-events: none;
    opacity: 0.05;
  }
  .watermark-blue,
  .watermark-orange {
    position: absolute;
    width: 330px;
    height: 330px;
    border-radius: 50px;
  }
  .watermark-blue {
    top: 50px;
    left: 50px;
    background: var(--blue);
    transform: rotate(-7deg);
  }
  .watermark-orange {
    right: 50px;
    bottom: 50px;
    background: var(--orange);
    transform: rotate(7deg);
  }
  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 900px;
  }
  .hero h1 {
    max-width: 900px;
  }
  .hero h1 span {
    color: var(--blue-bright);
  }
  .hero-description {
    max-width: 700px;
    margin-top: 30px;
    color: var(--grey-500);
    font-size: 19px;
    line-height: 1.7;
  }
  .company-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    margin-top: 40px;
    padding-top: 22px;
    border-top: 1px solid var(--grey-200);
  }
  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .meta-label {
    color: var(--grey-500);
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .meta-value {
    color: var(--black);
    font-size: 13px;
    font-weight: 600;
  }
  /* ================================                                                                                                                                                                                                                                                                                                                
         COMPANY                                                                                                                                                                                                                                                                                                                                          
      ================================= */
  .company {
    background: var(--black);
    color: white;
  }
  .company-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 100px;
    align-items: start;
  }
  .company h2 {
    max-width: 570px;
  }
  .company-copy {
    color: #a7adb5;
    font-size: 17px;
  }
  .company-copy p + p {
    margin-top: 24px;
  }
  .company-details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: 45px;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    border-left: 1px solid rgba(255, 255, 255, 0.15);
  }
  .detail {
    padding: 22px;
    border-right: 1px solid rgba(255, 255, 255, 0.15);
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  }
  .detail-label {
    color: var(--orange-light);
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .detail-value {
    margin-top: 12px;
    color: white;
    font-family: var(--display);
    font-size: 20px;
  }
  /* ================================                                                                                                                                                                                                                                                                                                                
         WHAT WE DO                                                                                                                                                                                                                                                                                                                                       
      ================================= */
  .what-we-do {
    background: white;
  }
  .what-header {
    max-width: 760px;
    margin-bottom: 70px;
  }
  .what-header p {
    max-width: 680px;
    margin-top: 25px;
    color: var(--grey-500);
    font-size: 17px;
  }
  .areas-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--grey-200);
    border-left: 1px solid var(--grey-200);
  }
  .area {
    min-height: 250px;
    padding: 30px;
    border-right: 1px solid var(--grey-200);
    border-bottom: 1px solid var(--grey-200);
  }
  .area-icon,
  .belief-icon {
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(21, 87, 213, 0.18);
    border-radius: 10px;
    color: var(--blue);
    background: var(--blue-soft);
  }

  .area-icon svg,
  .belief-icon svg {
    width: 24px;
    height: 24px;
  }

  .area-icon {
    margin-bottom: 30px;
  }

  .area h3 {
    margin-top: 0;
    font-size: 25px;
  }
  .area p {
    margin-top: 14px;
    color: var(--grey-500);
    font-size: 14px;
  }
  /* ================================                                                                                                                                                                                                                                                                                                                
         TEAM                                                                                                                                                                                                                                                                                                                                             
      ================================= */
  .team {
    background: var(--grey-100);
  }
  .team-header {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 90px;
    align-items: end;
    margin-bottom: 70px;
  }
  .team-header p {
    max-width: 620px;
    color: var(--grey-500);
    font-size: 17px;
  }
  .team-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  .team-card {
    position: relative;
    overflow: hidden;
    padding: 34px;
    border: 1px solid var(--grey-200);
    border-radius: 12px;
    background: white;
    transition:
      transform 0.35s ease,
      box-shadow 0.35s ease,
      border-color 0.35s ease;
  }
  .team-card:hover {
    transform: translateY(-6px);
    border-color: rgba(21, 87, 213, 0.35);
    box-shadow: 0 30px 70px rgba(21, 87, 213, 0.12);
  }
  .team-card::after {
    content: "";
    position: absolute;
    width: 250px;
    height: 250px;
    right: -110px;
    bottom: -110px;
    border: 1px solid rgba(21, 87, 213, 0.12);
    border-radius: 50%;
  }
  .team-photo {
    width: 145px;
    height: 145px;
    margin-top: 0;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--blue-soft), var(--grey-100));
    border: 1px solid var(--grey-200);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--blue);
    font-family: var(--display);
    font-size: 42px;
    font-weight: 600;
  }
  .team-card h3 {
    margin-top: 32px;
    font-size: 32px;
  }
  .team-role {
    margin-top: 8px;
    color: var(--blue);
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .team-card p {
    max-width: 500px;
    margin-top: 22px;
    color: var(--grey-500);
    font-size: 15px;
    line-height: 1.7;
  }
  .team-focus {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 27px;
  }
  .team-focus span {
    padding: 7px 10px;
    border-radius: 4px;
    color: var(--grey-700);
    background: var(--grey-100);
    font-family: var(--mono);
    font-size: 9px;
  }
  /* ================================                                                                                                                                                                                                                                                                                                                
         PARTNERSHIP                                                                                                                                                                                                                                                                                                                                      
      ================================= */
  .mission-vision {
    background: var(--white);
  }

  .mission-vision-header {
    max-width: 820px;
    margin-bottom: 65px;
  }

  .mission-vision-header h2 {
    max-width: 780px;
  }

  .mission-vision-header p {
    max-width: 720px;
    margin-top: 26px;
    color: var(--grey-500);
    font-size: 17px;
    line-height: 1.7;
  }

  .mission-vision-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  .mission-card,
  .vision-card {
    min-height: 330px;
    padding: 34px;
    border: 1px solid var(--grey-200);
    border-radius: 12px;
    background: var(--grey-50);
    transition:
      transform 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .mission-card:hover,
  .vision-card:hover {
    transform: translateY(-5px);
    border-color: rgba(21, 87, 213, 0.3);
    box-shadow: 0 24px 55px rgba(21, 87, 213, 0.1);
  }

  .mission-icon,
  .vision-icon {
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(21, 87, 213, 0.18);
    border-radius: 10px;
    color: var(--blue);
    background: var(--blue-soft);
  }

  .vision-icon {
    color: var(--orange);
    border-color: rgba(255, 106, 44, 0.2);
    background: var(--orange-soft);
  }

  .mission-icon svg,
  .vision-icon svg {
    width: 25px;
    height: 25px;
  }

  .mission-card h3,
  .vision-card h3 {
    margin-top: 34px;
    font-size: 27px;
  }

  .mission-card p,
  .vision-card p {
    max-width: 540px;
    margin-top: 14px;
    color: var(--grey-500);
    font-size: 14px;
    line-height: 1.75;
  }

  .mission-principle {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: 55px;
  }

  .principle-line {
    width: 65px;
    height: 2px;
    flex: 0 0 65px;
    background: var(--orange);
  }

  .mission-principle p {
    color: var(--ink);
    font-family: var(--display);
    font-size: clamp(22px, 3vw, 31px);
    line-height: 1.15;
  }

  .partnership {
    background: white;
  }
  .partnership-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 90px;
    align-items: center;
  }
  .partnership-copy p {
    max-width: 600px;
    margin-top: 25px;
    color: var(--grey-500);
    font-size: 17px;
  }
  .partnership-statement {
    margin-top: 42px;
    font-family: var(--display);
    font-size: clamp(26px, 3vw, 40px);
    line-height: 1.08;
  }
  .partnership-visual {
    position: relative;
    min-height: 430px;
    padding: 35px;
    border-radius: 12px;
    background: var(--black);
    overflow: hidden;
  }
  .partnership-visual::before {
    content: "";
    position: absolute;
    width: 420px;
    height: 420px;
    top: -150px;
    right: -120px;
    border-radius: 50%;
    border: 1px solid rgba(45, 124, 255, 0.4);
  }
  .partnership-visual::after {
    content: "";
    position: absolute;
    width: 300px;
    height: 300px;
    bottom: -130px;
    left: -100px;
    border-radius: 50%;
    border: 1px solid rgba(255, 106, 44, 0.35);
  }
  .connection {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 360px;
  }
  .connection-line {
    position: absolute;
    width: 55%;
    height: 1px;
    background: linear-gradient(90deg, var(--blue), var(--orange));
  }
  .connection-node {
    position: relative;
    z-index: 3;
    width: 145px;
    height: 145px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    color: white;
    text-align: center;
    background: #161616;
    font-family: var(--display);
    font-size: 18px;
  }
  .connection-node:first-child {
    transform: translateX(-80px);
  }
  .connection-node:last-child {
    transform: translateX(80px);
  }
  .connection-center {
    position: absolute;
    z-index: 4;
    width: 100px;
    height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: white;
    background: var(--blue);
    font-family: var(--mono);
    font-size: 10px;
    text-align: center;
    text-transform: uppercase;
  }
  /* ================================                                                                                                                                                                                                                                                                                                                
         BELIEF                                                                                                                                                                                                                                                                                                                                           
      ================================= */
  .belief {
    background: var(--blue);
    color: white;
  }
  .belief-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 90px;
    align-items: start;
  }
  .belief h2 {
    max-width: 560px;
  }
  .belief-copy {
    color: rgba(255, 255, 255, 0.78);
    font-size: 17px;
  }
  .belief-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    border-left: 1px solid rgba(255, 255, 255, 0.18);
  }
  .belief-item {
    min-height: 180px;
    padding: 25px;
    border-right: 1px solid rgba(255, 255, 255, 0.18);
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
  }
  .belief-item span {
    color: var(--orange-light);
    font-family: var(--mono);
    font-size: 10px;
  }
  .belief-icon {
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--orange-light);
    border-color: rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.08);
  }

  .belief-icon + h3 {
    margin-top: 25px;
  }

  .belief-item h3 {
    margin-top: 35px;
    font-size: 20px;
  }
  .belief-item p {
    margin-top: 10px;
    color: rgba(255, 255, 255, 0.62);
    font-size: 13px;
  }
  /* ================================                                                                                                                                                                                                                                                                                                                
         DIRECTION                                                                                                                                                                                                                                                                                                                                        
      ================================= */
  .direction {
    position: relative;
    overflow: hidden;
    color: white;
    background: #101216;
  }
  .direction::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        circle at 80% 30%,
        rgba(21, 87, 213, 0.28),
        transparent 35%
      ),
      radial-gradient(
        circle at 20% 80%,
        rgba(255, 106, 44, 0.12),
        transparent 30%
      );
  }
  .direction .container {
    position: relative;
    z-index: 2;
  }
  .direction h2 {
    max-width: 850px;
  }
  .direction-copy {
    max-width: 680px;
    margin-top: 30px;
    color: #b3b9c1;
    font-size: 17px;
  }
  .direction-statement {
    max-width: 900px;
    margin-top: 80px;
    padding-top: 35px;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    font-family: var(--display);
    font-size: clamp(2.3rem, 5vw, 4.5rem);
    line-height: 1;
  }
  /* ================================                                                                                                                                                                                                                                                                                                                
         CTA                                                                                                                                                                                                                                                                                                                                              
      ================================= */
  .final-cta {
    padding: 95px 0;
    color: white;
    background: linear-gradient(135deg, var(--blue), var(--blue-bright));
  }
  .final-cta-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 60px;
    align-items: end;
  }
  .final-cta h2 {
    max-width: 700px;
  }
  .final-cta p {
    max-width: 570px;
    margin-top: 20px;
    color: rgba(255, 255, 255, 0.84);
    font-size: 16px;
  }
  .cta-actions {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  .cta-actions .btn {
    min-width: 210px;
  }
  .cta-actions .btn-primary {
    color: var(--orange);
    background: white;
  }
  .cta-actions .btn-primary:hover {
    color: white;
    background: var(--orange);
  }
  .cta-actions .btn-outline {
    color: white;
    border-color: rgba(255, 255, 255, 0.5);
    background: transparent;
  }
  /* ================================                                                                                                                                                                                                                                                                                                                
         REVEAL                                                                                                                                                                                                                                                                                                                                           
      ================================= */
  .reveal {
    opacity: 0;
    transform: translateY(25px);
    transition:
      opacity 0.9s cubic-bezier(0.19, 1, 0.22, 1),
      transform 0.9s cubic-bezier(0.19, 1, 0.22, 1);
  }
  .reveal.visible {
    opacity: 1;
    transform: none;
  }
  /* ================================                                                                                                                                                                                                                                                                                                                
         RESPONSIVE                                                                                                                                                                                                                                                                                                                                       
      ================================= */
  @media (max-width: 1000px) {
    .mission-vision-grid {
      grid-template-columns: 1fr;
    }

    .mission-card,
    .vision-card {
      min-height: auto;
    }

    .mission-principle {
      align-items: flex-start;
    }

    .company-grid,
    .partnership-grid,
    .belief-grid,
    .team-header {
      grid-template-columns: 1fr;
    }
    .company-grid,
    .partnership-grid,
    .belief-grid {
      gap: 55px;
    }
    .areas-grid {
      grid-template-columns: 1fr 1fr;
    }
    .team-grid {
      grid-template-columns: 1fr;
    }
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 700px) {
    .container {
      width: min(var(--max), calc(100% - 40px));
    }
    .section {
      padding: 85px 0;
    }
    .nav-inner {
      height: 68px;
    }
    .nav-toggle {
      display: block;
    }
    .nav-links {
      position: fixed;
      top: 68px;
      left: 0;
      right: 0;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 15px 20px 25px;
      border-bottom: 1px solid var(--grey-200);
      background: white;
      transform: translateY(-120%);
      transition: transform 0.25s ease;
    }
    .nav-links.open {
      transform: translateY(0);
    }
    .nav-links a {
      padding: 13px 0;
    }
    .nav-cta {
      margin-top: 8px;
      text-align: center;
    }
    .hero {
      padding: 135px 0 80px;
    }
    .hero h1 {
      font-size: clamp(3rem, 15vw, 4.5rem);
    }
    .hero-description {
      font-size: 17px;
    }
    .hero-watermark {
      width: 400px;
      height: 400px;
      left: 70%;
    }
    .watermark-blue,
    .watermark-orange {
      width: 230px;
      height: 230px;
    }
    .company-details {
      grid-template-columns: 1fr;
    }
    .areas-grid {
      grid-template-columns: 1fr;
    }
    .team-card {
      padding: 27px;
    }
    .team-photo {
      width: 125px;
      height: 125px;
    }
    .belief-list {
      grid-template-columns: 1fr;
    }
    .partnership-visual {
      min-height: 360px;
    }
    .connection {
      min-height: 300px;
    }
    .connection-node {
      width: 115px;
      height: 115px;
      font-size: 15px;
    }
    .connection-node:first-child {
      transform: translateX(-50px);
    }
    .connection-node:last-child {
      transform: translateX(50px);
    }
    .connection-center {
      width: 78px;
      height: 78px;
    }
    .final-cta-inner {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 12px;
      align-items: flex-start;
    }
    .direction-statement {
      margin-top: 65px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
    * {
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
    }
  }

  /* =========================================                                                                                                                                                                                                                                                                                                       
         TEAM IMAGE ORBITS                                                                                                                                                                                                                                                                                                                                
      ========================================= */
  .team-photo {
    position: relative;
    overflow: visible;
    isolation: isolate;
  }
  .team-photo > img {
    position: relative;
    z-index: 3;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 22px;
    filter: saturate(0.98);
    transform: translateZ(0);
    animation: founderFloat 5s ease-in-out infinite;
  }
  .team-card:nth-child(2) .team-photo > img {
    animation-delay: -2.2s;
  }
  .team-orbit {
    position: absolute;
    left: 50%;
    top: 50%;
    border: 1.5px solid rgba(45, 124, 255, 0.32);
    border-radius: 50%;
    pointer-events: none;
    z-index: 1;
    transform: translate(-50%, -50%) rotate(-18deg);
  }
  .team-orbit-one {
    width: 118%;
    height: 72%;
    animation: orbitOne 9s linear infinite;
  }
  .team-orbit-two {
    width: 128%;
    height: 86%;
    border-color: rgba(255, 106, 44, 0.42);
    transform: translate(-50%, -50%) rotate(58deg);
    animation: orbitTwo 12s linear infinite reverse;
  }
  .team-orbit::after {
    content: "";
    position: absolute;
    width: 8px;
    height: 8px;
    right: 9%;
    top: 8%;
    border-radius: 50%;
    background: var(--orange);
    box-shadow: 0 0 0 5px rgba(255, 106, 44, 0.1);
  }
  .team-orbit-two::after {
    right: auto;
    left: 8%;
    top: auto;
    bottom: 8%;
    background: var(--blue-bright);
    box-shadow: 0 0 0 5px rgba(45, 124, 255, 0.1);
  }
  @keyframes founderFloat {
    0%,
    100% {
      transform: translateY(0) scale(1);
    }
    50% {
      transform: translateY(-6px) scale(1.012);
    }
  }
  @keyframes orbitOne {
    from {
      transform: translate(-50%, -50%) rotate(-18deg);
    }
