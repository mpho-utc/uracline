---
import Layout, { type SEOProps } from "../layouts/Layout.astro";

const seo: SEOProps = {
  title: "Uracline Space — Financial Intelligence Through Technology",
  description:
    "Technology that turns complex taxation, accounting, compliance and financial management into something people can understand, manage and act on.",
  robots: "index, follow, max-image-preview:large",
  author: "Uracline Space",
  canonical: "https://uraclinespace.com/",
  keywords:
    "financial technology, taxation, accounting, compliance, financial management, financial intelligence",
  og: {
    title: "Uracline Space — Financial Intelligence Through Technology",
    description:
      "Technology that turns complex taxation, accounting, compliance and financial management into something people can understand, manage and act on.",
    type: "website",
    url: "https://uraclinespace.com/",
    image: "https://uraclinespace.com/resources/uracline_logo.png",
    imageAlt: "Uracline Space",
  },
  twitter: {
    card: "summary_large_image",
    title: "Uracline Space — Financial Intelligence Through Technology",
    description:
      "Technology that turns complex taxation, accounting, compliance and financial management into something people can understand, manage and act on.",
    image: "https://uraclinespace.com/resources/uracline_logo.png",
  },
  schema: {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Uracline Space",
    url: "https://uraclinespace.com/",
    logo: "https://uraclinespace.com/resources/uracline_logo.png",
    description:
      "Financial technology built to simplify taxation, accounting, compliance and financial management.",
    sameAs: [
      "https://www.linkedin.com/company/uracline-space/",
      "https://www.facebook.com/profile.php?id=61592486981478",
      "https://www.instagram.com/uracline_space/",
    ],
  },
};
---

<Layout seo={seo}>
  <div id="top">
    <!-- ================================
         01 — HERO
    ================================= -->
      <section class="hero">
        <div class="hero-logo-bg" aria-hidden="true">
          <span class="logo-bg-square logo-bg-square--blue"></span>
          <span class="logo-bg-square logo-bg-square--orange"></span>
        </div>
        <div class="container hero-grid">
          <div class="hero-copy reveal">
<h1>
              Financial complexity&nbsp; 
              <span>should end somewhere.</span>
            </h1>
            <p class="hero-description">
              We build technology that turns complex taxation, accounting,
              compliance and financial management into something people can
              understand, manage and act on.
            </p>
            <div class="hero-actions">
              <a href="/about/" class="btn btn-primary">
                Explore what we're building <div class="btn-icon" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 12h15"></path><path d="m13 6 6 6-6 6"></path></svg></div>
              </a>
            </div>
          </div>
          <div class="phone-stage reveal">
            <div class="phone-shadow" aria-hidden="true"></div>
            <div class="phone-device">
              <img
                src="/resources/phone-card.png"
                alt="Uracline Space financial workflow application displayed on a mobile phone"
                class="phone-image"
                loading="eager"
                decoding="async"
              />
            </div>
          </div>
        </div>
      </section>
      <!-- ================================
         02 — PROBLEM
    ================================= -->
      <section class="section problem" id="problem">
        <div class="container">
          <div class="problem-grid">
            <div class="reveal">
            <h2>Financial systems keep getting more complicated.</h2>
            </div>
            <div class="problem-copy reveal">
              <p>
                More rules. More platforms. More transactions. More information.
              </p>
              <p style="margin-top: 18px">
                Yet people are still expected to understand what they owe, what
                they can claim, what needs to be filed and what needs attention.
              </p>
              <strong> The complexity keeps moving downstream. </strong>
            </div>
          </div>
          <div class="complexity-map reveal" style="margin-top: 70px">
            <div class="complexity-node node-1"><div class="node-icon" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="4" y="2.5" width="16" height="19" rx="2"></rect><rect x="7" y="5.5" width="10" height="4"></rect><path d="M7 13h2M12 13h2M17 13h0M7 17h2M12 17h2M17 17h0"></path></svg></div><span>TAX RULES</span></div>
            <div class="complexity-node node-2"><div class="node-icon" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="3" width="6" height="6" rx="1"></rect><rect x="15" y="15" width="6" height="6" rx="1"></rect><rect x="15" y="3" width="6" height="6" rx="1"></rect><path d="M9 6h6M18 9v6M9 6c0 6 9 0 9 9"></path></svg></div><span>TRANSACTIONS</span></div>
            <div class="complexity-node node-3"><div class="node-icon" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 3h8l4 4v14H6z"></path><path d="M14 3v5h4M9 13h6M9 17h6"></path></svg></div><span>DOCUMENTS</span></div>
            <div class="complexity-node node-4"><div class="node-icon" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 3h8l4 4v14H6z"></path><path d="M14 3v5h4M9 15l2 2 4-4"></path></svg></div><span>DEADLINES</span></div>
            <div class="complexity-node node-5"><div class="node-icon" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m12 3 9 5-9 5-9-5 9-5Z"></path><path d="m3 12 9 5 9-5M3 16l9 5 9-5"></path></svg></div><span>PLATFORMS</span></div>
            <div class="complexity-node node-6"><div class="node-icon" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 19V5M4 19h16"></path><path d="m7 15 3-4 3 2 5-7"></path></svg></div><span>REPORTING</span></div>
            <div class="complexity-line line-1"></div>
            <div class="complexity-line line-2"></div>
            <div class="complexity-line line-3"></div>
            <div class="complexity-line line-4"></div>
            <div class="map-center">
              Financial<br />
              complexity
            </div>
          </div>
        </div>
      </section>
      <!-- ================================
         03 — WHO EXPERIENCES IT
    ================================= -->
      <section class="section" id="audience">
        <div class="container audience-grid">
          <div class="audience-copy reveal">
            <h2>Different people. The same problem.</h2>
            <p style="margin-top: 25px">
              Creators, drivers, business owners, professionals and
              organisations may face completely different financial situations.
            </p>
            <strong>
              Too much complexity between people and the decisions they need to
              make.
            </strong>
          </div>
          <div class="audience-cloud reveal">
            <span class="audience-tag core"> Financial complexity </span>
            <span class="audience-tag">Individuals</span>
            <span class="audience-tag">Entrepreneurs</span>
            <span class="audience-tag">Creators</span>
            <span class="audience-tag">Freelancers</span>
            <span class="audience-tag">Drivers</span>
            <span class="audience-tag">Students</span>
            <span class="audience-tag">Accountants</span>
            <span class="audience-tag">Tax Practitioners</span>
            <span class="audience-tag">Law Firms</span>
            <span class="audience-tag">Small Businesses</span>
            <span class="audience-tag">Finance Professionals</span>
            <span class="audience-tag">Organisations</span>
          </div>
        </div>
      </section>
      <!-- ================================
         04 — BELIEF
    ================================= -->
      <section class="section belief" id="belief">
        <div class="container belief-layout">
          <div class="belief-copy reveal">
            <h2>Applications should remove complexity, not create it.</h2>
            <p>
              We believe good applications should do the difficult work quietly —
              bringing information together, simplifying complicated processes
              and showing people what matters next.
            </p>
            <p>
              That starts with understanding the problem before building the
              solution.
            </p>
            <div class="belief-statement">
              The goal isn't to make finance more technical.<br />
              <strong>It's to make it more understandable.</strong>
            </div>
          </div>
          <div class="belief-visual reveal">
            <img
              src="https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?auto=format&fit=crop&w=1200&q=85"
              alt="People collaborating around technology"
            />
            <div class="belief-overlay">
              <span>
                Start with the problem.<br />
                Understand it properly.<br />
                Build what creates value.
              </span>
            </div>
          </div>
        </div>
      </section>
      <!-- ================================
         05 — APPROACH
    ================================= -->
      <section class="section approach" id="approach">
        <div class="container">
          <div class="section-header reveal">
            <h2>We start with the problem.</h2>
            <p>
              We research how financial problems actually work — the rules,
              processes, behaviours and systems behind them. That understanding
              shapes what we build.
            </p>
          </div>
          <div class="process reveal">
            <div class="process-step">
              <div class="process-icon" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 5 5"></path></svg></div>
              <h3>Research</h3>
              <p>Investigate the systems, rules and real-world problem.</p>
            </div>
            <div class="process-step">
              <div class="process-icon" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9.5 4.5A3.5 3.5 0 0 0 6 8v.5A3.5 3.5 0 0 0 4 12a3.5 3.5 0 0 0 3.5 3.5H9v-11Z"></path><path d="M14.5 4.5A3.5 3.5 0 0 1 18 8v.5a3.5 3.5 0 0 1 2 3.5 3.5 3.5 0 0 1-3.5 3.5H15v-11Z"></path><path d="M9 8h1.5M9 12h2M15 8h-1.5M15 12h-2"></path><path d="M9 15.5V19a3 3 0 0 0 6 0v-3.5"></path></svg></div>
              <h3>Understand</h3>
              <p>Find the friction, behaviour and underlying need.</p>
            </div>
            <div class="process-step">
              <div class="process-icon" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="3" width="6" height="6" rx="1"></rect><rect x="15" y="15" width="6" height="6" rx="1"></rect><rect x="15" y="3" width="6" height="6" rx="1"></rect><path d="M9 6h6M18 9v6M9 6c0 6 9 0 9 9"></path></svg></div>
              <h3>Build</h3>
              <p>Turn understanding into practical technology.</p>
            </div>
            <div class="process-step">
              <div class="process-icon" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20 11a8 8 0 0 0-14.8-4L3 10"></path><path d="M3 5v5h5M4 13a8 8 0 0 0 14.8 4L21 14"></path><path d="M21 19v-5h-5"></path></svg></div>
              <h3>Improve</h3>
              <p>Learn from reality and continuously make it better.</p>
            </div>
          </div>
          <div class="approach-bottom reveal">
            <strong>
              Less friction. Better understanding. More useful outcomes.
            </strong>
</div>
        </div>
      </section>
      <!-- ================================
         06 — PEOPLE
    ================================= -->
<!-- ================================
         06 — ECOSYSTEM
    ================================= -->
      <section class="section ecosystem" id="ecosystem">
        <div class="container">
          <div class="section-header reveal">
            <h2>Different problems. One connected direction.</h2>
            <p>
              We're building a growing family of technology applications for taxation,
              accounting, compliance and financial management. Each starts with a
              specific problem. Together, they form something bigger.
            </p>
          </div>
          <div class="ecosystem-grid">
            <article class="ecosystem-card reveal">
              <div class="card-icon" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="4" y="2.5" width="16" height="19" rx="2"></rect><rect x="7" y="5.5" width="10" height="4"></rect><path d="M7 13h2M12 13h2M17 13h0M7 17h2M12 17h2M17 17h0"></path></svg></div>
              <h3>Taxation</h3>
              <p>
                Make obligations easier to understand, calculate and manage.
              </p>
              <div class="product-list">
                <span class="product-pill">CreatorTax</span>
                <span class="product-pill">DriverTax</span>
                <span class="product-pill">TaxAI</span>
                <span class="product-pill">VAT</span>
              </div>
            </article>
            <article class="ecosystem-card reveal">
              <div class="card-icon" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v17H6.5A2.5 2.5 0 0 0 4 22V5.5Z"></path><path d="M4 5.5V22M8 7h8M8 11h7"></path></svg></div>
              <h3>Accounting</h3>
              <p>
                Build practical applications that support accounting workflows, reduce
                friction and make financial work easier to manage.
              </p>
              <div class="product-list">
                <span class="product-pill">Trust</span>
                <span class="product-pill">Books</span>
                <span class="product-pill">Ledger</span>
                <span class="product-pill">Assets</span>
              </div>
            </article>
            <article class="ecosystem-card reveal">
              <div class="card-icon" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3 20 6v5c0 5-3.2 8.4-8 10-4.8-1.6-8-5-8-10V6l8-3Z"></path><path d="m8.5 12 2.2 2.2 4.8-5"></path></svg></div>
              <h3>Compliance</h3>
              <p>
                Stay organised, informed and ahead of financial obligations.
              </p>
              <div class="product-list">
                <span class="product-pill">Compliance</span>
                <span class="product-pill">Filing</span>
                <span class="product-pill">CompanyHub</span>
                <span class="product-pill">Vault</span>
              </div>
            </article>
            <article class="ecosystem-card reveal">
              <div class="card-icon" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 15a8 8 0 1 1 16 0"></path><path d="M12 12l4-4"></path><path d="M6 18h12"></path></svg></div>
              <h3>Financial Intelligence</h3>
              <p>
                Build applications that support financial understanding and better decision-making.
              </p>
              <div class="product-list">
                <span class="product-pill">AI</span>
                <span class="product-pill">Insights</span>
                <span class="product-pill">Forecast</span>
                <span class="product-pill">Advisor</span>
              </div>
            </article>
          </div>
          <div class="ecosystem-closing reveal">
            Every product starts with a problem worth solving.
          </div>
        </div>
      </section>
      <!-- ================================
         07 — TRUST
    ================================= -->
      <section class="section trust" id="trust">
        <div class="container">
          <div class="trust-layout">
            <div class="trust-intro reveal">
            <h2>Trust should come from how we work.</h2>
              <p>
                Financial technology has consequences. Accuracy, reliability and
                transparency aren't optional.
              </p>
              <p>
                We build from research and evidence, communicate limitations
                honestly and continuously improve as financial systems change.
              </p>
            </div>
            <div class="trust-grid reveal">
              <article class="trust-item">
                <div class="trust-icon" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 5 5"></path></svg></div>
                <h3>Research before assumptions.</h3>
                <p>Understand the problem before building.</p>
              </article>
              <article class="trust-item">
                <div class="trust-icon" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 3h8l4 4v14H6z"></path><path d="M14 3v5h4M9 15l2 2 4-4"></path></svg></div>
                <h3>Evidence before claims.</h3>
                <p>Ground important decisions in credible information.</p>
              </article>
              <article class="trust-item">
                <div class="trust-icon" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"></path><circle cx="12" cy="12" r="2.5"></circle></svg></div>
                <h3>Transparency over certainty.</h3>
                <p>Say what we know — and what we don't.</p>
              </article>
              <article class="trust-item">
                <div class="trust-icon" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20 11a8 8 0 0 0-14.8-4L3 10"></path><path d="M3 5v5h5M4 13a8 8 0 0 0 14.8 4L21 14"></path><path d="M21 19v-5h-5"></path></svg></div>
                <h3>Improvement over perfection.</h3>
                <p>Build, learn and improve as systems change.</p>
              </article>
            </div>
          </div>
          <div class="trust-closing reveal">
            Build something worth trusting with your financial life.
          </div>
        </div>
      </section>
      <!-- ================================
         08 — TEAM
    ================================= -->
<!-- ================================
         09 — KNOWLEDGE
    ================================= -->
      <section class="section" id="knowledge">
        <div class="container knowledge-layout">
          <div class="knowledge-intro reveal">
            <h2>Understand the systems behind the decisions.</h2>
            <p>
              We explore the systems, rules and trends shaping financial life —
              turning complex subjects into clear explanations, useful insights
              and practical knowledge.
            </p>
            <p>Clear explanations. Useful insights. Practical tools.</p>
            <div class="knowledge-closing">
              Learn something.<br />
              Understand it.<br />
              Make a better decision.
            </div>
          </div>
          <div class="knowledge-grid reveal">
            <article class="knowledge-card">
              <div class="knowledge-icon" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 5 5"></path></svg></div>
              <h3>Research & analysis.</h3>
              <p>
                Evidence and analysis of the problems shaping financial systems.
              </p>
            </article>
            <article class="knowledge-card">
              <div class="knowledge-icon" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 19V5M4 19h16"></path><path d="m7 15 3-4 3 2 5-7"></path></svg></div>
              <h3>Perspectives on financial change.</h3>
              <p>Legislation, technology, markets and emerging trends.</p>
            </article>
            <article class="knowledge-card">
              <div class="knowledge-icon" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 18h6M10 21h4"></path><path d="M8 14.5a6 6 0 1 1 8 0c-1 .8-1.5 1.6-1.5 2.5h-5c0-.9-.5-1.7-1.5-2.5Z"></path></svg></div>
              <h3>Practical answers.</h3>
              <p>Clear explanations for real financial questions.</p>
            </article>
            <article class="knowledge-card">
              <div class="knowledge-icon" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m12 3 9 5-9 5-9-5 9-5Z"></path><path d="m3 12 9 5 9-5M3 16l9 5 9-5"></path></svg></div>
              <h3>Knowledge you can apply.</h3>
              <p>Technology that turns understanding into action.</p>
            </article>
          </div>
        </div>
      </section>
      <!-- ================================
         10 — AMBITION
    ================================= -->
      <section class="section ambition" id="ambition">
        <div class="container">
<h2 class="reveal">
            A financial technology ecosystem built for the world.
          </h2>
          <p class="ambition-copy reveal">
            We're building towards a connected financial technology ecosystem where
            applications support taxation, accounting, compliance and financial
            management rather than forcing people to navigate disconnected processes.
          </p>
          <div class="ambition-statement reveal">
            A clearer way forward for every financial decision.
          </div>
          <p class="ambition-small reveal">
            From solving individual problems today to building the financial
            technology ecosystem the world can rely on tomorrow.
          </p>
        </div>
      </section>
      <!-- ================================
         11 — CTA
    ================================= -->
      <section class="final-cta" id="contact">
        <div class="container final-cta-inner">
          <div>
            <h2>Find a clearer way forward.</h2>
            <p>
              Explore what we're building, discover useful knowledge, or talk to
              us about a financial problem worth solving.
            </p>
          </div>
          <div class="cta-actions">
            <a href="#ecosystem" class="btn btn-primary">
              Explore our solutions <div class="btn-icon" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 12h15"></path><path d="m13 6 6 6-6 6"></path></svg></div>
            </a>
            <a
              href="https://knowledgeos-delta.vercel.app/articles"
              class="btn btn-outline"
              target="_blank"
              rel="noopener noreferrer"
            >
              Explore knowledge <div class="btn-icon" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 12h15"></path><path d="m13 6 6 6-6 6"></path></svg></div>
            </a>
            <a href="mailto:tumelorabane458@gmail.com" class="btn btn-outline">
              Talk to us <div class="btn-icon" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 12h15"></path><path d="m13 6 6 6-6 6"></path></svg></div>
            </a>
          </div>
        </div>
      </section>
  </div>
</Layout>

<style>
      @import url("https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap");

:root {
        --orange: #ff6a2c;
        --orange-light: #ff8f52;
        --orange-soft: #fff1e8;
        --blue: #1557d5;
        --blue-bright: #2d7cff;
        --blue-soft: #eaf1ff;
        --black: #0d0d0d;
        --ink: #15171b;
        --white: #ffffff;
        --grey-50: #fafafa;
        --grey-100: #f4f5f7;
        --grey-200: #e4e7eb;
        --grey-300: #d1d5db;
        --grey-500: #68707c;
        --grey-700: #343a43;
        --max: 1180px;
        --display: "Space Grotesk", sans-serif;
        --body: "Inter", sans-serif;
        --mono: "IBM Plex Mono", monospace;
      }
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      :global(html) {
        scroll-behavior: smooth;
      }
      :global(body) {
        font-family: var(--body);
        color: var(--ink);
        background: var(--white);
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
      }
      :global(body.menu-open) {
        overflow: hidden;
      }
      :global(a) {
        color: inherit;
        text-decoration: none;
      }
      :global(button) {
        font: inherit;
      }
      :global(img) {
        display: block;
        width: 100%;
      }
      :global(::selection) {
        background: var(--blue);
        color: white;
      }
      .container {
        width: min(var(--max), calc(100% - 64px));
        margin: 0 auto;
      }
      .mono {
        font-family: var(--mono);
      }
      h1,
      h2,
      h3 {
        font-family: var(--display);
        letter-spacing: -0.035em;
        line-height: 1.05;
      }
      h1 {
        font-size: clamp(3.2rem, 6vw, 5.6rem);
        font-weight: 600;
      }
      h2 {
        font-size: clamp(2.4rem, 4.5vw, 4rem);
        font-weight: 600;
      }
      h3 {
        font-size: 1.25rem;
      }
      .section {
        padding: 130px 0;
      }
      .section-header {
        max-width: 720px;
        margin-bottom: 70px;
      }
      .section-header p {
        margin-top: 24px;
        color: var(--grey-500);
        font-size: 17px;
        max-width: 650px;
      }
      
/* -------------------------------- ICON SYSTEM -------------------------------- */

.card-icon,
.process-icon,
.trust-icon,
.knowledge-icon,
.node-icon,
.btn-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  color: var(--blue);
}

.card-icon svg,
.process-icon svg,
.trust-icon svg,
.knowledge-icon svg,
.node-icon svg,
.btn-icon svg {
  width: 100%;
  height: 100%;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.7;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.card-icon {
  width: 42px;
  height: 42px;
  margin-bottom: 30px;
  padding: 9px;
  border: 1px solid var(--grey-200);
  border-radius: 8px;
  background: var(--blue-soft);
}

.process-icon {
  width: 34px;
  height: 34px;
  margin-bottom: 38px;
  color: var(--orange);
}

.trust-icon {
  width: 32px;
  height: 32px;
  margin-bottom: 28px;
  color: var(--orange);
}

.knowledge-icon {
  width: 34px;
  height: 34px;
  margin-bottom: 30px;
  color: var(--blue);
}

.node-icon {
  width: 14px;
  height: 14px;
  color: var(--blue-bright);
}

.btn-icon {
  width: 16px;
  height: 16px;
  color: currentColor;
}

/* -------------------------------- BUTTONS -------------------------------- */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-height: 48px;
        padding: 0 20px;
        border-radius: 6px;
        font-size: 14px;
        font-weight: 600;
        transition:
          transform 0.2s ease,
          background 0.2s ease,
          border-color 0.2s ease;
      }
      .btn:hover {
        transform: translateY(-2px);
      }
      .btn-primary {
        color: white;
        background: var(--orange);
      }
      .btn-primary:hover {
        background: var(--orange-light);
      }
      .btn-outline {
        color: var(--black);
        border: 1px solid var(--grey-300);
        background: white;
      }
      .btn-outline:hover {
        border-color: var(--black);
      }
      /* -------------------------------- HERO -------------------------------- */
     .hero {
  position: relative;
  overflow: hidden;
  padding: 120px 0 120px;

  background:
    linear-gradient(
      rgba(13, 13, 13, 0.045) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(13, 13, 13, 0.045) 1px,
      transparent 1px
    );

  background-size: 48px 48px;
}
      .hero::after {
        content: "";
        position: absolute;
        width: 650px;
        height: 650px;
        top: 80px;
        right: -280px;
        background: radial-gradient(
          circle,
          rgba(21, 87, 213, 0.12),
          transparent 68%
        );
        pointer-events: none;
      }
      /* Fading logo watermark behind the hero content */
      .hero-logo-bg {
        position: absolute;
        top: 50%;
        left: 50%;
        z-index: 0;
        width: 620px;
        height: 620px;
        transform: translate(-50%, -50%);
        pointer-events: none;
      }
      .logo-bg-square {
        position: absolute;
        inset: 0;
        margin: auto;
        width: 360px;
        height: 360px;
        border-radius: 54px;
        opacity: 0;
      }
      .logo-bg-square--blue {
        background: var(--blue);
        transform: translate(-9%, -9%) rotate(-6deg);
        animation: logoBgFadeIn 2.6s cubic-bezier(0.19, 1, 0.22, 1) 0.3s
          forwards;
      }
      .logo-bg-square--orange {
        background: var(--orange);
        transform: translate(9%, 9%) rotate(6deg);
        animation: logoBgFadeIn 2.6s cubic-bezier(0.19, 1, 0.22, 1) 0.7s
          forwards;
      }
      @keyframes logoBgFadeIn {
        from {
          opacity: 0;
        }
        to {
          opacity: 0.06;
        }
      }
      .hero-grid {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: 1.05fr 0.95fr;
        gap: 80px;
        align-items: center;
      }
      .hero-copy {
        position: relative;
        z-index: 2;
      }
      .hero h1 {
        max-width: 720px;
      }
      .hero h1 span {
        color: var(--blue-bright);
      }
      .hero-description {
        max-width: 570px;
        margin-top: 28px;
        color: var(--grey-500);
        font-size: 18px;
      }
      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 36px;
      }
      /* -------------------------------- HERO PHONE -------------------------------- */
      .phone-stage {
        position: relative;
        z-index: 2;
        min-height: 620px;
        display: flex;
        align-items: center;
        justify-content: center;
        isolation: isolate;
      }

      .phone-device {
        position: relative;
        z-index: 2;
        width: min(100%, 430px);
        display: flex;
        justify-content: center;
        will-change: transform;
        animation: phoneFloat 5.2s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;
      }

      .phone-image {
        display: block;
        width: 100%;
        height: auto;
        max-height: 690px;
        object-fit: contain;
        filter: drop-shadow(0 18px 24px rgba(13, 13, 13, 0.12));
        user-select: none;
        -webkit-user-drag: none;
      }

      .phone-shadow {
        position: absolute;
        z-index: 1;
        left: 50%;
        bottom: 7%;
        width: 48%;
        height: 30px;
        border-radius: 50%;
        background: rgba(13, 13, 13, 0.2);
        filter: blur(18px);
        transform: translateX(-50%) scale(0.82);
        opacity: 0.48;
        will-change: transform, opacity;
        animation: phoneShadow 5.2s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;
      }

      @keyframes phoneFloat {
        0%,
        100% {
          transform: translate3d(0, 0, 0) rotate(0deg);
        }
        25% {
          transform: translate3d(0, -7px, 0) rotate(-0.35deg);
        }
        50% {
          transform: translate3d(0, -13px, 0) rotate(0deg);
        }
        75% {
          transform: translate3d(0, -7px, 0) rotate(0.35deg);
        }
      }

      @keyframes phoneShadow {
        0%,
        100% {
          transform: translateX(-50%) scale(0.82);
          opacity: 0.48;
        }
        25% {
          transform: translateX(-50%) scale(0.72);
          opacity: 0.38;
        }
        50% {
          transform: translateX(-50%) scale(0.58);
          opacity: 0.25;
        }
        75% {
          transform: translateX(-50%) scale(0.72);
          opacity: 0.38;
        }
      }

      /* -------------------------------- PROBLEM -------------------------------- */
      .problem {
        background: var(--black);
        color: white;
      }
      .problem-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 70px;
        align-items: end;
      }
      .problem h2 {
        max-width: 650px;
      }
      .problem-copy {
        color: #a7adb5;
        font-size: 17px;
      }
      .problem-copy strong {
        display: block;
        margin-top: 25px;
        color: white;
        font-family: var(--display);
        font-size: 21px;
        font-weight: 500;
      }
      .complexity-map {
        position: relative;
        min-height: 360px;
        border: 1px solid #272727;
        border-radius: 12px;
        background:
          radial-gradient(
            circle at center,
            rgba(255, 106, 44, 0.09),
            transparent 35%
          ),
          #111;
      }
      .map-center {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 150px;
        height: 150px;
        display: flex;
        align-items: center;
        justify-content: center;
        transform: translate(-50%, -50%);
        border: 1px solid rgba(255, 106, 44, 0.5);
        border-radius: 50%;
        color: white;
        text-align: center;
        font-family: var(--display);
        font-size: 17px;
        background: #161616;
        box-shadow: 0 0 70px rgba(255, 106, 44, 0.1);
      }
      .complexity-node {
        position: absolute;
        padding: 9px 12px;
        border: 1px solid #303030;
        border-radius: 5px;
        color: #b4bac1;
        font-family: var(--mono);
        font-size: 10px;
        background: #181818;
      }
      .node-1 {
        top: 12%;
        left: 12%;
      }
      .node-2 {
        top: 18%;
        right: 10%;
      }
      .node-3 {
        bottom: 16%;
        left: 10%;
      }
      .node-4 {
        bottom: 12%;
        right: 12%;
      }
      .node-5 {
        top: 47%;
        left: 5%;
      }
      .node-6 {
        top: 48%;
        right: 5%;
      }
      .complexity-line {
        position: absolute;
        height: 1px;
        background: linear-gradient(
          90deg,
          transparent,
          rgba(45, 124, 255, 0.55),
          transparent
        );
        transform-origin: left center;
      }
      .line-1 {
        width: 35%;
        top: 28%;
        left: 27%;
        transform: rotate(25deg);
      }
      .line-2 {
        width: 34%;
        top: 30%;
        left: 52%;
        transform: rotate(-25deg);
      }
      .line-3 {
        width: 35%;
        bottom: 28%;
        left: 26%;
        transform: rotate(-25deg);
      }
      .line-4 {
        width: 34%;
        bottom: 27%;
        left: 53%;
        transform: rotate(25deg);
      }
      /* -------------------------------- AUDIENCE -------------------------------- */
      .audience-grid {
        display: grid;
        grid-template-columns: 0.8fr 1.2fr;
        gap: 80px;
        align-items: center;
      }
      .audience-copy p {
        color: var(--grey-500);
        font-size: 17px;
      }
      .audience-copy strong {
        display: block;
        margin-top: 22px;
        font-family: var(--display);
        font-size: 22px;
        line-height: 1.25;
      }
      .audience-cloud {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 9px;
      }
      .audience-tag {
        padding: 10px 14px;
        border: 1px solid var(--grey-200);
        border-radius: 100px;
        color: var(--grey-700);
        background: white;
        font-family: var(--mono);
        font-size: 11px;
        transition: 0.2s ease;
      }
      .audience-tag:hover {
        color: var(--orange);
        border-color: var(--orange);
        transform: translateY(-2px);
      }
      .audience-tag.core {
        color: white;
        background: var(--blue);
        border-color: var(--blue);
      }
      /* -------------------------------- BELIEF -------------------------------- */
      .belief {
        background: var(--grey-100);
      }
      .belief-layout {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 90px;
        align-items: center;
      }
      .belief-copy p {
        margin-top: 25px;
        max-width: 570px;
        color: var(--grey-500);
        font-size: 17px;
      }
      .belief-statement {
        margin-top: 40px;
        padding-left: 25px;
        border-left: 2px solid var(--blue);
        font-family: var(--display);
        font-size: clamp(25px, 3vw, 38px);
        line-height: 1.1;
      }
      .belief-visual {
        position: relative;
        min-height: 470px;
        border-radius: 12px;
        overflow: hidden;
        background: var(--black);
      }
      .belief-visual img {
        position: absolute;
        inset: 0;
        height: 100%;
        object-fit: cover;
        opacity: 0.42;
      }
      .belief-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(
          135deg,
          rgba(13, 13, 13, 0.85),
          rgba(21, 87, 213, 0.25)
        );
      }
      .belief-overlay span {
        max-width: 350px;
        padding: 25px;
        color: white;
        font-family: var(--display);
        font-size: 27px;
        line-height: 1.15;
        border: 1px solid rgba(255, 255, 255, 0.15);
        background: rgba(13, 13, 13, 0.55);
        backdrop-filter: blur(8px);
      }
      /* -------------------------------- APPROACH -------------------------------- */
      .approach {
        background: white;
      }
      .process {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        border-top: 1px solid var(--grey-200);
        border-bottom: 1px solid var(--grey-200);
      }
      .process-step {
        position: relative;
        min-height: 220px;
        padding: 30px;
        border-right: 1px solid var(--grey-200);
      }
      .process-step:last-child {
        border-right: 0;
      }
      .process-step h3 {
        margin-top: 0;
      }
      .process-step p {
        margin-top: 10px;
        color: var(--grey-500);
        font-size: 13px;
      }
      .approach-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 45px;
      }
      .approach-bottom strong {
        font-family: var(--display);
        font-size: 22px;
      }
      /* -------------------------------- ECOSYSTEM -------------------------------- */
      .ecosystem {
        background: var(--grey-100);
      }
      .ecosystem-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
      }
      .ecosystem-card {
        position: relative;
        min-height: 350px;
        padding: 26px;
        border: 1px solid var(--grey-200);
        border-radius: 10px;
        background: white;
        overflow: hidden;
        transition:
          transform 0.3s cubic-bezier(0.19, 1, 0.22, 1),
          border-color 0.3s ease,
          box-shadow 0.3s ease;
      }
      .ecosystem-card:hover {
        transform: translateY(-5px);
        border-color: var(--blue);
        box-shadow: 0 22px 45px rgba(21, 87, 213, 0.12);
      }
      .ecosystem-card::after {
        content: "";
        position: absolute;
        width: 140px;
        height: 140px;
        right: -50px;
        bottom: -50px;
        border: 1px solid rgba(21, 87, 213, 0.18);
        border-radius: 50%;
      }
      .ecosystem-card h3 {
        margin-top: 0;
        font-size: 25px;
      }
      .ecosystem-card p {
        margin-top: 15px;
        color: var(--grey-500);
        font-size: 13.5px;
      }
      .product-list {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        margin-top: 30px;
      }
      .product-pill {
        padding: 6px 9px;
        border-radius: 4px;
        background: var(--grey-100);
        color: var(--grey-700);
        font-family: var(--mono);
        font-size: 9px;
      }
      .ecosystem-closing {
        margin-top: 35px;
        font-family: var(--display);
        font-size: 24px;
      }
      /* -------------------------------- TRUST -------------------------------- */
      .trust {
        background: var(--black);
        color: white;
      }
      .trust-layout {
        display: grid;
        grid-template-columns: 0.8fr 1.2fr;
        gap: 90px;
      }
      .trust-intro p {
        margin-top: 25px;
        color: #a7adb5;
        font-size: 16px;
      }
      .trust-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        border-top: 1px solid #292929;
        border-left: 1px solid #292929;
      }
      .trust-item {
        min-height: 180px;
        padding: 26px;
        border-right: 1px solid #292929;
        border-bottom: 1px solid #292929;
        transition: background 0.3s ease;
      }
      .trust-item:hover {
        background: rgba(21, 87, 213, 0.08);
      }
      .trust-item span {
        color: var(--orange);
        font-family: var(--mono);
        font-size: 10px;
      }
      .trust-item h3 {
        margin-top: 0;
        font-size: 18px;
      }
      .trust-item p {
        margin-top: 9px;
        color: #8d949d;
        font-size: 13px;
      }
      .trust-closing {
        margin-top: 60px;
        font-family: var(--display);
        font-size: clamp(26px, 3vw, 38px);
        line-height: 1.1;
      }
      /* -------------------------------- TEAM -------------------------------- */
      .team {
        background: var(--white);
      }
      .team-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 18px;
      }
      .team-card {
        display: grid;
        grid-template-columns: 180px 1fr;
        min-height: 250px;
        border: 1px solid var(--grey-200);
        background: white;
        overflow: hidden;
        transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
      }
      .team-card:hover {
        transform: translateY(-5px);
        border-color: var(--blue);
        box-shadow: 0 22px 45px rgba(21, 87, 213, 0.1);
      }
      .team-photo {
        position: relative;
        min-height: 250px;
        background: var(--grey-100);
        overflow: hidden;
      }
      .team-photo img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
      }
      .team-info {
        padding: 28px;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
      }
      .team-info h3 {
        font-size: 28px;
      }
      .team-info p {
        margin-top: 8px;
        color: var(--grey-500);
        font-size: 13px;
        max-width: 300px;
      }
      .team-closing {
        margin-top: 35px;
        max-width: 700px;
        font-family: var(--display);
        font-size: 25px;
        line-height: 1.2;
      }
      /* -------------------------------- KNOWLEDGE -------------------------------- */
      .knowledge-layout {
        display: grid;
        grid-template-columns: 0.75fr 1.25fr;
        gap: 90px;
      }
      .knowledge-intro p {
        margin-top: 25px;
        color: var(--grey-500);
        font-size: 17px;
      }
      .knowledge-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1px;
        background: var(--grey-200);
        border: 1px solid var(--grey-200);
      }
      .knowledge-card {
        min-height: 210px;
        padding: 27px;
        background: white;
        transition: 0.2s ease;
      }
      .knowledge-card:hover {
        background: var(--grey-50);
      }
      .knowledge-card h3 {
        margin-top: 0;
      }
      .knowledge-card p {
        margin-top: 9px;
        color: var(--grey-500);
        font-size: 13px;
      }
      .knowledge-closing {
        margin-top: 50px;
        font-family: var(--display);
        font-size: 25px;
      }
      /* -------------------------------- AMBITION -------------------------------- */
      .ambition {
        position: relative;
        overflow: hidden;
        color: white;
        background: #101216;
      }
      .ambition::before {
        content: "";
        position: absolute;
        inset: 0;
        background:
          linear-gradient(rgba(16, 18, 22, 0.78), rgba(16, 18, 22, 0.9)),
          url("https://images.unsplash.com/photo-1640340434855-6084b1f4901c?auto=format&fit=crop&w=1800&q=85");
        background-size: cover;
        background-position: center;
        opacity: 0.5;
      }
      .ambition .container {
        position: relative;
        z-index: 2;
      }
      .ambition h2 {
        max-width: 850px;
      }
      .ambition-copy {
        max-width: 680px;
        margin-top: 30px;
        color: #b3b9c1;
        font-size: 17px;
      }
      .ambition-statement {
        max-width: 900px;
        margin-top: 100px;
        padding-top: 35px;
        border-top: 1px solid rgba(255, 255, 255, 0.15);
        font-family: var(--display);
        font-size: clamp(2.3rem, 5vw, 4.5rem);
        line-height: 1;
      }
      .ambition-small {
        max-width: 600px;
        margin-top: 25px;
        color: #8c939d;
        font-size: 14px;
      }
      /* -------------------------------- CTA -------------------------------- */
      .final-cta {
        padding: 110px 0;
        background: linear-gradient(135deg, var(--blue), var(--blue-bright));
        color: white;
      }
      .final-cta-inner {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 60px;
        align-items: end;
      }
      .final-cta h2 {
        max-width: 700px;
      }
      .final-cta p {
        max-width: 570px;
        margin-top: 20px;
        color: rgba(255, 255, 255, 0.84);
        font-size: 16px;
      }
      .cta-actions {
        display: flex;
        flex-direction: column;
        gap: 9px;
      }
      .cta-actions .btn {
        min-width: 200px;
      }
      .cta-actions .btn-primary {
        color: var(--orange);
        background: white;
      }
      .cta-actions .btn-primary:hover {
        color: white;
        background: var(--orange);
      }
      .cta-actions .btn-outline {
        color: white;
        border-color: rgba(255, 255, 255, 0.5);
        background: transparent;
      }
      /* -------------------------------- REVEAL -------------------------------- */
      .reveal {
        opacity: 0;
        transform: translateY(25px);
        transition:
          opacity 1s cubic-bezier(0.19, 1, 0.22, 1),
          transform 1s cubic-bezier(0.19, 1, 0.22, 1);
      }
      .reveal.visible {
        opacity: 1;
        transform: none;
      }
      /* -------------------------------- PEOPLE / PROFILE CARDS -------------------------------- */
      .people-section {
        background: white;
      }
      .people-header {
        display: grid;
        grid-template-columns: 0.8fr 1.2fr;
        gap: 80px;
        align-items: end;
        margin-bottom: 65px;
      }
      .people-header p {
        max-width: 650px;
        color: var(--grey-500);
        font-size: 17px;
      }
      .people-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
      }
      .person-card {
        position: relative;
        min-height: 510px;
        padding: 28px;
        border: 1px solid var(--grey-200);
        border-radius: 18px;
        overflow: hidden;
        background: var(--grey-50);
        isolation: isolate;
        transition:
          transform 0.55s cubic-bezier(0.19, 1, 0.22, 1),
          border-color 0.35s ease,
          box-shadow 0.55s cubic-bezier(0.19, 1, 0.22, 1);
      }
      .person-card:hover {
        transform: translateY(-9px);
        border-color: rgba(21, 87, 213, 0.35);
        box-shadow: 0 30px 70px rgba(21, 87, 213, 0.14);
      }
      .person-card::before,
      .person-card::after {
